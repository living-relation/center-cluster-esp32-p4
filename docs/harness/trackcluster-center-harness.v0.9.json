  "schematicNotes": [
    { "id": "n_title", "text": "TrackCluster center assembly — pins/wires only (no connectors). Center J8 at middle; peripherals around. From WIRING.md + CONNECTOR_BOM_AND_HARNESS.md.", "schematicPosition": { "x": 30, "y": 30 }, "width": 390, "color": "Light Blue", "alignment": "Left" },
    { "id": "n_power", "text": "POWER — Pololu D36V50F5\n12V IGN → buck → +5V star to Center/Left/Right\nCommon GND with vehicle", "schematicPosition": { "x": 1260, "y": 30 }, "width": 270, "color": "Yellow" },
    { "id": "n_center", "text": "CENTER — Waveshare ESP32-P4\nJ8 screw-terminal adapter SM-A-001\nFerrules on T# landings", "schematicPosition": { "x": 1200, "y": 420 }, "width": 210, "color": "Light Green" },
    { "id": "n_left", "text": "LEFT S3 — 480×480\nUART TX-only 921600\nFlash via USB-C (not GPIO43/44)", "schematicPosition": { "x": 30, "y": 360 }, "width": 210, "color": "Light Blue" },
    { "id": "n_right", "text": "RIGHT S3 — 480×480\nUART TX-only 921600\nFlash via USB-C", "schematicPosition": { "x": 1680, "y": 360 }, "width": 210, "color": "Light Blue" },
    { "id": "n_can", "text": "CAN — SN65HVD230 @ 3V3\n1 Mbit/s · twisted CANH/CANL\n120Ω term at xcvr end\nECU usually has other 120Ω", "schematicPosition": { "x": 1440, "y": 300 }, "width": 270, "color": "Orange" },
    { "id": "n_ctrl", "text": "CONTROLS — active-low to GND\nEnc1 Boost · Enc2 TC · Enc3 Dim\nEnc3 SW resets night brightness to 40%\nODO cycles trip modes", "schematicPosition": { "x": 30, "y": 1860 }, "width": 270, "color": "Pink" },
    { "id": "n_hl", "text": "HEADLIGHT SENSE — PC817 opto\nGPIO28 LOW = lights ON = dim\nNEVER feed +12V to GPIO28\nCollector → GPIO28 · Emitter → GND", "schematicPosition": { "x": 1680, "y": 1290 }, "width": 270, "color": "Violet" },
    { "id": "n_groups", "text": "In the app: group terminals by device and assign Group Parts (Center / Left / Right / Buck / CAN xcvr / Enc1–3 / ODO / PC817 / ECU).", "schematicPosition": { "x": 720, "y": 1860 }, "width": 390, "color": "Gray" }
